{
  "name": "trello-clone",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace apps/backend & npm run dev --workspace apps/frontend",
    "build": "npm run build --workspace apps/backend && npm run build --workspace apps/frontend",
    "test": "npm run test --workspace apps/backend",
    "lint": "npm run lint --workspace apps/frontend",
    "keep-backend-awake": "node scripts/keep-backend-awake.mjs",
    "db:generate": "npm run db:generate --workspace apps/backend",
    "db:migrate": "npm run db:migrate --workspace apps/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace apps/backend"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
